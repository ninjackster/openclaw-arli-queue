{
  "id": "arli-queue",
  "name": "Arli Queue",
  "description": "Queues requests to a one-slot model provider and cleans stray whitespace from path tool arguments.",
  "categories": [
    "models"
  ],
  "providers": [
    "arli"
  ],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "providers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "maxConcurrent": {
        "type": "integer",
        "minimum": 1
      },
      "holdAfterAbortMs": {
        "type": "number",
        "minimum": 0
      },
      "cleanToolArgs": {
        "type": "boolean"
      }
    }
  }
}
